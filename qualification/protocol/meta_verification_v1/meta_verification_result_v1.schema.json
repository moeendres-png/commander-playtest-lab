{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commander-lab.invalid/schema/meta-verification-result-v1.json",
  "title": "Commander Lab Meta Verification Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "source_tape",
    "results",
    "attempted",
    "killed",
    "survived",
    "not_run",
    "kill_rate",
    "catalog_coverage"
  ],
  "properties": {
    "schema_version": {"const": "commander-lab.meta-verification-result/1.0.0"},
    "catalog_version": {"const": "commander-lab.rules-mutation-catalog/1.0.0"},
    "source_tape": {"type": "string", "minLength": 1},
    "attempted": {"type": "integer", "minimum": 0},
    "killed": {"type": "integer", "minimum": 0},
    "survived": {"type": "integer", "minimum": 0},
    "not_run": {"type": "integer", "minimum": 0},
    "kill_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "catalog_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mutation_id", "status", "expected_detector", "observed_detector"],
        "properties": {
          "mutation_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["KILLED", "SURVIVED", "NOT_RUN"]},
          "expected_detector": {"type": "string", "minLength": 1},
          "observed_detector": {"type": ["string", "null"]},
          "record_index": {"type": ["integer", "null"]}
        }
      }
    }
  }
}
