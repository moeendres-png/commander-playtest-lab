{
  "$id": "https://commander-lab.local/schemas/candidate_fixture_manifest_v1_1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "denominator_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "fixtures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "authority_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "card_identity": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expected_evidence_class": {
            "enum": [
              "RUNTIME_VERIFIED"
            ]
          },
          "fixture_id": {
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "player_count": {
            "maximum": 6,
            "minimum": 2,
            "type": "integer"
          },
          "requirement_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "seed": {
            "minimum": 0,
            "type": "integer"
          },
          "viewer_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "fixture_id",
          "category",
          "requirement_ids",
          "player_count",
          "expected_evidence_class",
          "mandatory",
          "seed"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "protocol": {
      "const": "commander-lab.rules-service/1.1.0"
    },
    "schema_version": {
      "const": "candidate-fixture-manifest/1.1.0"
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "authority_lock_sha256",
    "denominator_hashes",
    "fixtures"
  ],
  "type": "object"
}
