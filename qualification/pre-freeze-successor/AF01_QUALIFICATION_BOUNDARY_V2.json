{
  "schema_version": "commander-lab.af01-qualification-boundary/2.0.0",
  "boundary_id": "commander-lab.pre-freeze-qualification/2.0.0",
  "supersedes_for_future_freeze_adjudication": "commander-lab.rules-service/1.1.0",
  "historical_rsp_1_1_preserved": true,
  "candidate_neutral": true,
  "transport": {
    "protocol_version_source": "config/rules_engines.json#protocol_version",
    "required_version": "2.0.0",
    "schema_path": "schemas/engine_adapter_protocol.schema.json",
    "schema_git_blob_at_source_lock": "ea8651f75a1461ecc41dc1f24586c00bff97fee5",
    "legacy_alias_only_handshake_satisfies_af01": false
  },
  "required_handshake": {
    "messages": [
      "start_engine",
      "get_provider_version",
      "get_capabilities"
    ],
    "exact_request_response_protocol_version": true,
    "matching_request_id": true,
    "exact_provider_identity": true,
    "exact_engine_version_or_commit_identity": true,
    "explicit_capability_payload": true,
    "runtime_kind_must_be_external_rules_engine": true
  },
  "truthful_capability_requirements": {
    "capability_values_must_be_provider_reported": true,
    "client_may_not_infer_support_from_provider_name": true,
    "missing_or_unproven_required_capability_must_not_be_promoted": true,
    "degraded_is_valid_truthful_state_but_not_af01_pass_when_required_handshake_invariants_are_missing": true
  },
  "rules_authority_invariants": {
    "rules_core_sole_legality_authority": true,
    "adapter_or_pilot_legality_reconstruction_forbidden": true,
    "fabricated_legal_options_forbidden": true,
    "rules_randomness_core_owned": true
  },
  "fail_closed_invariants": {
    "protocol_mismatch": "FAILED_RESPONSE_NO_GAME_MUTATION",
    "unknown_message": "FAILED_RESPONSE_NO_GAME_MUTATION",
    "illegal_action": "FAILED_RESPONSE_NO_GAME_MUTATION",
    "stale_or_unknown_decision": "FAILED_RESPONSE_NO_GAME_MUTATION",
    "unsupported_production_reachable_decision": "TYPED_UNSUPPORTED_OR_TERMINAL_FAILURE_NO_DEFAULT"
  },
  "af01_pass_requires": [
    "exact source/build/adapter identity recorded",
    "protocol version equals current common transport protocol",
    "exact protocol schema identity recorded",
    "canonical handshake messages succeed",
    "capabilities are explicitly reported and truthful",
    "unsupported and invalid paths fail closed without mutation",
    "no adapter/pilot legality reconstruction is reachable"
  ],
  "nonclaims": [
    "AF01 PASS does not imply AF04 decision completeness",
    "AF01 PASS does not imply provider release eligibility",
    "AF01 PASS does not select a provider or claim Architecture Freeze"
  ]
}
