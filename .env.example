# Required only for live OpenAI agent workflows. Never commit a real key.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-sol

# The Agents SDK trace is remote; the lab also keeps a separate local trace without game logs.
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0

# Reproducibility and storage defaults.
COMMANDER_LAB_DATA_DIR=./data
COMMANDER_LAB_DB_PATH=./data/runs/commander_lab.sqlite3
COMMANDER_LAB_LOG_LEVEL=INFO

# Large local simulations require the exact approval token configured by the application.
COMMANDER_LAB_LARGE_RUN_APPROVAL_TOKEN=

# Optional cost-policy defaults. Model-specific rates remain configuration, not hard-coded prices.
COMMANDER_LAB_API_BUDGET_USD=5.00
COMMANDER_LAB_INPUT_COST_PER_MILLION_USD=0
COMMANDER_LAB_OUTPUT_COST_PER_MILLION_USD=0
