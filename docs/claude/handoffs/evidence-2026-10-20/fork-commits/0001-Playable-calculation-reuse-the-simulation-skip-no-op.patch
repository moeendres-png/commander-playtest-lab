     public void checkTriggers(GameEvent event, Game game) {
         processingStart(event);
         boolean needErrorChecksOnEnd = true;
+        // Optimization: quick pre-check without copying. checkEventType() is a pure
+        // type comparison (no state mutation). If no trigger matches the event type,
+        // skip the ArrayList copy entirely. Most game events don't trigger anything.
+        boolean anyMatch = false;
+        for (TriggeredAbility ability : this.values()) {
+            if (ability.checkEventType(event, game)) {
+                anyMatch = true;
+                break;
+            }
+        }
+        if (!anyMatch) {
+            processingEnd(needErrorChecksOnEnd);
+            return;
+        }
         // must keep real object refs (not copies), cause check trigger code can change trigger's and effect's data like targets
         ArrayList<TriggeredAbility> currentTriggers = new ArrayList<>(this.values());
