+package mage.cards.d;
+
+import java.util.UUID;
+import mage.abilities.Ability;
+import mage.abilities.common.SacrificePermanentTriggeredAbility;
+import mage.abilities.effects.common.DrawCardSourceControllerEffect;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.constants.CardType;
+import mage.filter.FilterPermanent;
+import mage.constants.SubType;
+
+/**
+ * Simplified implementation for Commander Lab simulation.
+ * Complex return-to-battlefield ability omitted.
+ *
+ * @author Muse
+ */
+public final class DesertWarfare extends CardImpl {
+
+    private static final FilterPermanent filter = new FilterPermanent("a Desert");
+
+    static {
+        filter.add(SubType.DESERT.getPredicate());
+    }
+
+    public DesertWarfare(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.ENCHANTMENT}, "{3}{G}");
+
+        // Whenever you sacrifice a Desert, draw a card.
+        this.addAbility(new SacrificePermanentTriggeredAbility(
+                new DrawCardSourceControllerEffect(1), filter));
+    }
+
+    private DesertWarfare(final DesertWarfare card) {
+        super(card);
+    }
+
+    @Override
+    public DesertWarfare copy() {
+        return new DesertWarfare(this);
+    }
+}
