+package mage.cards.s;
+
+import java.util.UUID;
+import mage.abilities.LoyaltyAbility;
+import mage.abilities.effects.common.DestroyTargetEffect;
+import mage.abilities.effects.common.counter.AddCountersTargetEffect;
+import mage.abilities.effects.common.combat.CantBeBlockedTargetEffect;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.constants.CardType;
+import mage.constants.Duration;
+import mage.constants.SubType;
+import mage.constants.SuperType;
+import mage.counters.CounterType;
+import mage.target.common.TargetCreaturePermanent;
+
+/**
+ * @author Muse (Commander Playtest Lab)
+ *
+ * Space Beleren {2}{W}{U}
+ * Legendary Planeswalker - Jace
+ * Loyalty 3
+ * [+1]: Up to one target creature can't be blocked this turn.
+ * [-1]: Put a +1/+1 counter on target creature.
+ * [-5]: Destroy target creature.
+ *
+ * Note: Simplified - the "Space sculptor" sector mechanic is omitted as it
+ * is Unfinity-specific and not relevant for Commander simulation. Abilities
+ * are simplified to target single creatures instead of sectors.
+ */
+public final class SpaceBeleren extends CardImpl {
+
+    public SpaceBeleren(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.PLANESWALKER}, "{2}{W}{U}");
+        this.supertype.add(SuperType.LEGENDARY);
+        this.subtype.add(SubType.JACE);
+
+        this.setStartingLoyalty(3);
+
+        // [+1]: Up to one target creature can't be blocked this turn.
+        LoyaltyAbility ability1 = new LoyaltyAbility(new CantBeBlockedTargetEffect(Duration.EndOfTurn), 1);
+        ability1.addTarget(new TargetCreaturePermanent(0, 1));
+        this.addAbility(ability1);
+
+        // [-1]: Put a +1/+1 counter on target creature.
+        LoyaltyAbility ability2 = new LoyaltyAbility(new AddCountersTargetEffect(CounterType.P1P1.createInstance()), -1);
+        ability2.addTarget(new TargetCreaturePermanent());
+        this.addAbility(ability2);
+
+        // [-5]: Destroy target creature.
+        LoyaltyAbility ability3 = new LoyaltyAbility(new DestroyTargetEffect(), -5);
+        ability3.addTarget(new TargetCreaturePermanent());
+        this.addAbility(ability3);
+    }
+
+    private SpaceBeleren(final SpaceBeleren card) {
+        super(card);
+    }
+
+    @Override
+    public SpaceBeleren copy() {
+        return new SpaceBeleren(this);
+    }
+}
