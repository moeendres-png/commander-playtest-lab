+package org.commanderlab.xmage;
+
+import mage.abilities.Ability;
+import mage.abilities.common.SimpleStaticAbility;
+import mage.abilities.effects.common.InfoEffect;
+import mage.cards.Card;
+import mage.constants.PhaseStep;
+import mage.constants.WatcherScope;
+import mage.constants.Zone;
+import mage.game.Game;
+import mage.game.events.GameEvent;
+import mage.game.permanent.Permanent;
+import mage.players.Player;
+import mage.util.CardUtil;
+import mage.watchers.Watcher;
+
+import java.util.ArrayList;
+import java.util.EnumSet;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+
+/**
+ * Places the restored face-up permanents at the start of the requested
+ * checkpoint step.
+ *
+ * <p>The requested state is a checkpoint, not a history. A permanent the engine
+ * held on the battlefield from before game start would observe the vehicle's
+ * own start-of-game procedure and arrival turns (opening-hand draws, the first
+ * draw step), which no legal game can show: the battlefield is empty during the
+ * start-of-game procedure (CR 103). So the cards are loaded before game start
+ * (outside the game, with their watchers registered) and enter the battlefield
+ * at the first event of the checkpoint step: the phase's begin event when the
+ * step opens its phase, otherwise the step's begin event. They are then present
+ * for everything the checkpoint step itself does, beginning-of-step triggers
+ * included, and for nothing before it.</p>
+ *
+ * <p>The placement uses the same primitive as the setup placement
+ * ({@code CardUtil.putCardOntoBattlefieldWithEffects}: no ETB event, no summoning
+ * sickness), and each permanent then stands in its requested tapped state. A
+ * watcher runs before the event's trigger check
+ * ({@code GameState.handleEvent}), so triggers of the checkpoint step's begin
+ * event see the placed permanents. Only cards whose battlefield side is the card
+ * itself are deferred: their permanent shares the card's abilities, so placing
+ * one registers no new watcher while the engine iterates its watchers. The
+ * fields are plain ids, so the engine's state copies carry the watcher.</p>
+ */
+final class XmageCheckpointPlacementWatcher extends Watcher {
+
+    private Integer turnNumber;
+    private Set<GameEvent.EventType> startEvents;
+    private List<UUID> cardIds;
+    private List<UUID> ownerIds;
+    private List<Boolean> tapped;
+    private boolean placed;
+
+    // Boxed: Watcher.copy() constructs with null for every non-boolean
+    // parameter before copying the fields.
+    XmageCheckpointPlacementWatcher(
+            Integer turnNumber,
+            Set<GameEvent.EventType> startEvents,
+            List<UUID> cardIds,
+            List<UUID> ownerIds,
+            List<Boolean> tapped) {
+        super(WatcherScope.GAME);
+        this.turnNumber = turnNumber;
+        this.startEvents = startEvents == null ? null : EnumSet.copyOf(startEvents);
+        this.cardIds = cardIds == null ? null : new ArrayList<>(cardIds);
+        this.ownerIds = ownerIds == null ? null : new ArrayList<>(ownerIds);
+        this.tapped = tapped == null ? null : new ArrayList<>(tapped);
+    }
+
+    /** The events that open {@code step}: its phase's begin event when it opens the phase, then its own. */
+    static Set<GameEvent.EventType> startEventsOf(PhaseStep step) {
+        return switch (step) {
+            case UNTAP -> EnumSet.of(GameEvent.EventType.BEGINNING_PHASE_PRE, GameEvent.EventType.UNTAP_STEP_PRE);
+            case UPKEEP -> EnumSet.of(GameEvent.EventType.UPKEEP_STEP_PRE);
+            case DRAW -> EnumSet.of(GameEvent.EventType.DRAW_STEP_PRE);
+            case PRECOMBAT_MAIN -> EnumSet.of(
+                    GameEvent.EventType.PRECOMBAT_MAIN_PHASE_PRE, GameEvent.EventType.PRECOMBAT_MAIN_STEP_PRE);
+            case BEGIN_COMBAT -> EnumSet.of(
+                    GameEvent.EventType.COMBAT_PHASE_PRE, GameEvent.EventType.BEGIN_COMBAT_STEP_PRE);
+            case DECLARE_ATTACKERS -> EnumSet.of(GameEvent.EventType.DECLARE_ATTACKERS_STEP_PRE);
+            case DECLARE_BLOCKERS -> EnumSet.of(GameEvent.EventType.DECLARE_BLOCKERS_STEP_PRE);
+            case FIRST_COMBAT_DAMAGE, COMBAT_DAMAGE -> EnumSet.of(GameEvent.EventType.COMBAT_DAMAGE_STEP_PRE);
+            case END_COMBAT -> EnumSet.of(GameEvent.EventType.END_COMBAT_STEP_PRE);
+            case POSTCOMBAT_MAIN -> EnumSet.of(
+                    GameEvent.EventType.POSTCOMBAT_MAIN_PHASE_PRE, GameEvent.EventType.POSTCOMBAT_MAIN_STEP_PRE);
+            case END_TURN -> EnumSet.of(GameEvent.EventType.END_PHASE_PRE, GameEvent.EventType.END_TURN_STEP_PRE);
+            case CLEANUP -> EnumSet.of(GameEvent.EventType.CLEANUP_STEP_PRE);
+        };
+    }
+
+    /** True for a card whose battlefield permanent is the card itself (no part or face is chosen). */
+    static boolean deferrable(Game game, Card card) {
+        return CardUtil.getDefaultCardSideForBattlefield(game, card) == card;
+    }
+
+    @Override
+    public void watch(GameEvent event, Game game) {
+        if (placed || game.getTurnNum() != turnNumber.intValue() || !startEvents.contains(event.getType())) {
+            return;
+        }
+        placed = true;
+        for (int index = 0; index < cardIds.size(); index++) {
+            Card card = game.getCard(cardIds.get(index));
+            Player owner = game.getPlayer(ownerIds.get(index));
+            if (card == null || owner == null || game.getState().getZone(card.getId()) != Zone.OUTSIDE) {
+                // Left for the checkpoint verification, which fails closed.
+                continue;
+            }
+            Ability placement = new SimpleStaticAbility(Zone.OUTSIDE, new InfoEffect("restoration placement"));
+            placement.setControllerId(owner.getId());
+            placement.setSourceId(card.getId());
+            CardUtil.putCardOntoBattlefieldWithEffects(placement, game, card, owner, false);
+            // The requested tapped state is checkpoint state: an "enters tapped"
+            // replacement applied by the placement is not, and no untap step
+            // follows inside the checkpoint step to undo it.
+            Permanent permanent = game.getPermanent(card.getId());
+            if (permanent != null) {
+                permanent.setTapped(tapped.get(index));
+            }
+        }
+    }
+
+    boolean placed() {
+        return placed;
+    }
+
+    List<UUID> cardIds() {
+        return List.copyOf(cardIds);
+    }
+}
