From 99b18b8f7281a1514ffab461d931a77bea7c7ba3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 00:26:53 +0000
Subject: [PATCH] Card scanner: test stored set cards with one query, not one
 per card

CardScanner.scan ran one findCard(setCode, cardNumber) query for each of
the ~90,000 set cards on every JVM start, about 2 s of every bridge start
in the Commander Lab (one JVM per game). It now reads the setCode and
cardNumber of every stored card once and checks membership in memory.
The test is the same: a set card counts as stored when any row, day or
night side, has its set code and card number. If the keys can't be read,
the scanner falls back to the per-card query.

Measured in the Lab on 14 real 4P games: start-up 8.6 s -> 6.6 s,
semantic transcripts identical to the unchanged engine in all 14.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NMGFC3XKC19Zhn4Yme1aNi
---
 .../mage/cards/repository/CardRepository.java | 26 +++++++++++++++++++
 .../mage/cards/repository/CardScanner.java    |  8 +++++-
 2 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/Mage/src/main/java/mage/cards/repository/CardRepository.java b/Mage/src/main/java/mage/cards/repository/CardRepository.java
index 68d564fb1d..0ef8d97204 100644
--- a/Mage/src/main/java/mage/cards/repository/CardRepository.java
+++ b/Mage/src/main/java/mage/cards/repository/CardRepository.java
@@ -755,6 +755,32 @@ public enum CardRepository {
     /**
      * Exec any SQL query and return result table as string values
      */
+    /**
+     * Keys (see {@link #setCodeAndCardNumberKey}) of every stored card, day and night sides,
+     * read in one query. Lets the card scanner test which set cards are already stored
+     * without one database query per set card. Null if the database can't be read.
+     */
+    public Set<String> findAllSetCodeAndCardNumberKeys() {
+        try {
+            QueryBuilder<CardInfo, Object> queryBuilder = cardsDao.queryBuilder();
+            queryBuilder.selectColumns("setCode", "cardNumber");
+            Set<String> keys = new HashSet<>();
+            try (GenericRawResults<String[]> rows = cardsDao.queryRaw(queryBuilder.prepareStatementString())) {
+                for (String[] row : rows) {
+                    keys.add(setCodeAndCardNumberKey(row[0], row[1]));
+                }
+            }
+            return keys;
+        } catch (Exception e) {
+            Logger.getLogger(CardRepository.class).error("Error reading card keys from DB: " + e, e);
+            return null;
+        }
+    }
+
+    public static String setCodeAndCardNumberKey(String setCode, String cardNumber) {
+        return setCode + '\u0000' + cardNumber;
+    }
+
     public List<List<String>> querySQL(String sql) {
         try {
             GenericRawResults<String[]> query = cardsDao.queryRaw(sql);
