{
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(gh api -X PUT repos/moeendres-png/commander-playtest-lab/pulls/*/merge *)",
      "mcp__github__merge_pull_request"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ruff_after_edit.py\"",
            "timeout": 30,
            "statusMessage": "ruff fix + format"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 600,
            "statusMessage": "project venv"
          }
        ]
      }
    ]
  }
}
