          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "deck_id",
        "deck_hash",
        "policy",
        "clauses",
        "source_run_hash"
      ],
      "title": "GeneratedKeepRule",
      "type": "object"
    },
    "HypergeometricBaseline": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
