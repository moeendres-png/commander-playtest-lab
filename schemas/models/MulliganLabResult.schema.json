        "clauses": {
          "items": {
            "$ref": "#/$defs/KeepRuleClause"
          },
          "title": "Clauses",
          "type": "array"
        },
        "deck_hash": {
          "title": "Deck Hash",
          "type": "string"
        },
        "deck_id": {
          "title": "Deck Id",
          "type": "string"
        },
        "exceptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exceptions",
          "type": "array"
        },
        "model_based": {
          "default": true,
          "title": "Model Based",
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/$defs/MulliganPolicyName"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "source_run_hash": {
          "title": "Source Run Hash",
          "type": "string"
        },
        "validation_contexts": {
          "default": [],
