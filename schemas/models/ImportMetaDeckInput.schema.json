{
  "$defs": {
    "FormatBand": {
      "enum": [
        "local_meta",
        "normal_four_player",
        "high_power",
        "cedh_tournament",
        "large_pod",
        "historical_reference",
        "synthetic_assumption"
      ],
      "title": "FormatBand",
      "type": "string"
    },
    "MetaCategory": {
      "enum": [
        "local_meta",
        "normal_four_player",
        "high_power",
        "cedh_tournament",
        "large_pod",
        "historical_reference",
        "synthetic_assumption"
      ],
      "title": "MetaCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_band": {
      "default": "unknown",
      "title": "Budget Band",
      "type": "string"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/MetaCategory"
      },
      "title": "Categories",
      "type": "array"
    },
    "commander": {
      "title": "Commander",
      "type": "string"
    },
    "decklist": {
      "items": {
        "type": "string"
      },
      "title": "Decklist",
      "type": "array"
    },
    "event_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Name"
    },
    "format_band": {
      "$ref": "#/$defs/FormatBand"
    },
    "placement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Placement"
    },
    "player_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Player Count"
    },
    "pod_size": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 4,
      "title": "Pod Size"
    },
    "snapshot_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Path"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "commander",
    "decklist",
    "format_band",
    "categories"
  ],
  "title": "ImportMetaDeckInput",
  "type": "object"
}
