{
  "$defs": {
    "SourceType": {
      "enum": [
        "direct_user_statement",
        "chat_conversation",
        "google_drive_file",
        "repository",
        "official_decklist",
        "tournament_result",
        "primer",
        "guide",
        "real_game",
        "synthetic_assumption",
        "model_inference",
        "web_research"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "verified",
        "hash_verified",
        "partially_verified",
        "unverified",
        "superseded",
        "missing"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "derived_from": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Derived From",
      "type": "array"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "license": {
      "default": "unknown",
      "title": "License",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "observed": {
      "default": false,
      "title": "Observed",
      "type": "boolean"
    },
    "package_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Version"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "supersedes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Supersedes",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "transformation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transformation"
    },
    "url_or_drive_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url Or Drive Id"
    },
    "usage_rights": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Usage Rights",
      "type": "array"
    },
    "verification_status": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "unverified"
    }
  },
  "required": [
    "source_id",
    "source_type",
    "title",
    "content_hash"
  ],
  "title": "SourceRecord",
  "type": "object"
}
