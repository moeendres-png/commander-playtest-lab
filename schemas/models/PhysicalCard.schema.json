{
  "$defs": {
    "CardCondition": {
      "enum": [
        "M",
        "NM",
        "EX",
        "GD",
        "LP",
        "PL",
        "PO",
        "UNKNOWN"
      ],
      "title": "CardCondition",
      "type": "string"
    },
    "PurchaseStatus": {
      "enum": [
        "owned",
        "ordered",
        "planned",
        "not_owned",
        "unknown"
