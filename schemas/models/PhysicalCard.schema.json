      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acquired On"
    },
    "box": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Box"
    },
    "collector_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collector Number"
    },
    "condition": {
      "$ref": "#/$defs/CardCondition",
      "default": "UNKNOWN"
    },
    "copy_id": {
      "minLength": 1,
      "title": "Copy Id",
      "type": "string"
    },
    "foil": {
      "default": false,
      "title": "Foil",
      "type": "boolean"
    },
    "language": {
      "default": "en",
      "title": "Language",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "oracle_name": {
      "minLength": 1,
      "title": "Oracle Name",
      "type": "string"
