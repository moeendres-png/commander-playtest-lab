{
  "$defs": {
    "PilotDecisionMode": {
      "enum": [
        "deterministic",
        "stochastic"
      ],
      "title": "PilotDecisionMode",
      "type": "string"
    },
    "PilotStrength": {
      "enum": [
        "weak",
        "average",
        "strong",
        "near_optimal_heuristic"
      ],
      "title": "PilotStrength",
      "type": "string"
    },
    "PilotUtilityWeights": {
      "additionalProperties": false,
      "properties": {
        "card_advantage": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Card Advantage",
          "type": "number"
        },
        "commander_value": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Commander Value",
          "type": "number"
        },
        "engine_development": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Engine Development",
          "type": "number"
        },
        "interaction_reserve": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Interaction Reserve",
          "type": "number"
        },
        "mana_efficiency": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Mana Efficiency",
          "type": "number"
        },
        "political_visibility": {
          "default": -0.65,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Political Visibility",
          "type": "number"
        },
        "rebuild_capacity": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Rebuild Capacity",
          "type": "number"
        },
        "survival": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Survival",
          "type": "number"
        },
        "tempo": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Tempo",
          "type": "number"
        },
        "threat_reduction": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Threat Reduction",
          "type": "number"
        },
        "win_progress": {
          "default": 1.0,
          "maximum": 5.0,
          "minimum": -5.0,
          "title": "Win Progress",
          "type": "number"
        }
      },
      "title": "PilotUtilityWeights",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mistake_rate": {
      "anyOf": [
        {
          "maximum": 0.5,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mistake Rate"
    },
    "mode": {
      "$ref": "#/$defs/PilotDecisionMode",
      "default": "deterministic"
    },
    "pilot_name": {
      "default": "auto",
      "title": "Pilot Name",
      "type": "string"
    },
    "reserve_mana_target": {
      "anyOf": [
        {
          "maximum": 10.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reserve Mana Target"
    },
    "strength": {
      "$ref": "#/$defs/PilotStrength",
      "default": "average"
    },
    "temperature": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 5.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "weights": {
      "anyOf": [
        {
          "$ref": "#/$defs/PilotUtilityWeights"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "PilotConfig",
  "type": "object"
}
