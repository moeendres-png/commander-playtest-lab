        "reported_by_player",
        "inferred_role",
        "unknown",
        "synthetic_assumption"
      ],
      "title": "ObservationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "constraint_id": {
      "title": "Constraint Id",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "required": {
      "default": true,
      "title": "Required",
      "type": "boolean"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
