{
  "$defs": {
    "DistributionSummary": {
      "additionalProperties": false,
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Confidence Level",
          "type": "number"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "mean_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Interval"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "observations": {
          "minimum": 0,
          "title": "Observations",
          "type": "integer"
        },
        "q25": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q25"
        },
        "q75": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q75"
        }
      },
      "required": [
        "observations",
        "missing"
      ],
      "title": "DistributionSummary",
      "type": "object"
    },
    "EvidenceSplit": {
      "enum": [
        "unsplit",
        "train",
        "validation",
        "excluded"
      ],
      "title": "EvidenceSplit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comparison_status": {
      "enum": [
        "available",
        "insufficient_real",
        "insufficient_simulated"
      ],
      "title": "Comparison Status",
      "type": "string"
    },
    "deck_key": {
      "title": "Deck Key",
      "type": "string"
    },
    "mean_delta_real_minus_simulated": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mean Delta Real Minus Simulated"
    },
    "metric": {
      "title": "Metric",
      "type": "string"
    },
    "notes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "real": {
      "$ref": "#/$defs/DistributionSummary"
    },
    "simulated": {
      "$ref": "#/$defs/DistributionSummary"
    },
    "split": {
      "$ref": "#/$defs/EvidenceSplit"
    }
  },
  "required": [
    "deck_key",
    "metric",
    "split",
    "real",
    "simulated",
    "comparison_status"
  ],
  "title": "MetricComparison",
  "type": "object"
}
