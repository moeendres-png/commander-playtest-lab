{
  "$defs": {
    "CalibrationParameterResult": {
      "additionalProperties": false,
      "properties": {
        "accepted_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Value"
        },
        "baseline_value": {
          "default": 1.0,
          "title": "Baseline Value",
          "type": "number"
        },
        "decision": {
          "$ref": "#/$defs/ParameterDecision"
        },
        "deck_key": {
          "title": "Deck Key",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "parameter_name": {
          "title": "Parameter Name",
          "type": "string"
        },
        "proposed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Value"
        },
        "rationale": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "array"
        },
        "train_difference_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Difference Interval"
        },
        "train_real_observations": {
          "minimum": 0,
          "title": "Train Real Observations",
          "type": "integer"
        },
        "train_simulated_observations": {
          "minimum": 0,
          "title": "Train Simulated Observations",
          "type": "integer"
        },
        "validation_error_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Error After"
        },
        "validation_error_before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Error Before"
        },
        "validation_improvement_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Improvement Fraction"
        },
        "validation_real_observations": {
          "minimum": 0,
          "title": "Validation Real Observations",
          "type": "integer"
        },
        "validation_simulated_observations": {
          "minimum": 0,
          "title": "Validation Simulated Observations",
          "type": "integer"
        }
      },
      "required": [
        "deck_key",
        "metric",
        "parameter_name",
        "decision",
        "train_real_observations",
        "validation_real_observations",
        "train_simulated_observations",
        "validation_simulated_observations"
      ],
      "title": "CalibrationParameterResult",
      "type": "object"
    },
    "CalibrationStatus": {
      "enum": [
        "not_run",
        "insufficient_evidence",
        "provisional",
        "validated_internal_holdout",
        "rejected_on_validation",
        "failed"
      ],
      "title": "CalibrationStatus",
      "type": "string"
    },
    "CategoryEstimate": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "interval": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Interval",
          "type": "array"
        },
        "proportion": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Proportion",
          "type": "number"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "count",
        "total",
        "proportion",
        "interval"
      ],
      "title": "CategoryEstimate",
      "type": "object"
    },
    "DistributionSummary": {
      "additionalProperties": false,
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Confidence Level",
          "type": "number"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "mean_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Interval"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "observations": {
          "minimum": 0,
          "title": "Observations",
          "type": "integer"
        },
        "q25": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q25"
        },
        "q75": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q75"
        }
      },
      "required": [
        "observations",
        "missing"
      ],
      "title": "DistributionSummary",
      "type": "object"
    },
    "EvidenceSplit": {
      "enum": [
        "unsplit",
        "train",
        "validation",
        "excluded"
      ],
      "title": "EvidenceSplit",
      "type": "string"
    },
    "MetricComparison": {
      "additionalProperties": false,
      "properties": {
        "comparison_status": {
          "enum": [
            "available",
            "insufficient_real",
            "insufficient_simulated"
          ],
          "title": "Comparison Status",
          "type": "string"
        },
        "deck_key": {
          "title": "Deck Key",
          "type": "string"
        },
        "mean_delta_real_minus_simulated": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Delta Real Minus Simulated"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "real": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "simulated": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "split": {
          "$ref": "#/$defs/EvidenceSplit"
        }
      },
      "required": [
        "deck_key",
        "metric",
        "split",
        "real",
        "simulated",
        "comparison_status"
      ],
      "title": "MetricComparison",
      "type": "object"
    },
    "ParameterDecision": {
      "enum": [
        "not_evaluated",
        "insufficient_evidence",
        "no_signal",
        "accepted_internal_holdout",
        "rejected_validation"
      ],
      "title": "ParameterDecision",
      "type": "string"
    },
    "SplitStrategy": {
      "enum": [
        "stable_hash",
        "chronological"
      ],
      "title": "SplitStrategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_parameters": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Accepted Parameters",
      "type": "object"
    },
    "bootstrap_samples": {
      "minimum": 100,
      "title": "Bootstrap Samples",
      "type": "integer"
    },
    "calibration_id": {
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_profile_applied": {
      "default": false,
      "title": "Calibration Profile Applied",
      "type": "boolean"
    },
    "categorical_real": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/CategoryEstimate"
        },
        "type": "object"
      },
      "title": "Categorical Real",
      "type": "object"
    },
    "categorical_simulated": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/CategoryEstimate"
        },
        "type": "object"
      },
      "title": "Categorical Simulated",
      "type": "object"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/MetricComparison"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "confidence_level": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Confidence Level",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Hash",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "engine_parameters_modified": {
      "default": false,
      "title": "Engine Parameters Modified",
      "type": "boolean"
    },
    "excluded_game_ids": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Game Ids",
      "type": "array"
    },
    "external_engine_validation_pending": {
      "default": true,
      "title": "External Engine Validation Pending",
      "type": "boolean"
    },
    "independent_confirmation": {
      "default": false,
      "title": "Independent Confirmation",
      "type": "boolean"
    },
    "internal_validation_only": {
      "default": true,
      "title": "Internal Validation Only",
      "type": "boolean"
    },
    "methodology": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Methodology",
      "type": "array"
    },
    "parameter_results": {
      "items": {
        "$ref": "#/$defs/CalibrationParameterResult"
      },
      "title": "Parameter Results",
      "type": "array"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "simulated_exclusion_reasons": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Simulated Exclusion Reasons",
      "type": "object"
    },
    "simulated_matches_excluded": {
      "default": 0,
      "minimum": 0,
      "title": "Simulated Matches Excluded",
      "type": "integer"
    },
    "simulated_matches_total": {
      "default": 0,
      "minimum": 0,
      "title": "Simulated Matches Total",
      "type": "integer"
    },
    "simulated_matches_used": {
      "default": 0,
      "minimum": 0,
      "title": "Simulated Matches Used",
      "type": "integer"
    },
    "simulation_estimate_types": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Simulation Estimate Types",
      "type": "array"
    },
    "simulation_master_seeds": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Simulation Master Seeds",
      "type": "array"
    },
    "simulation_run_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Simulation Run Ids",
      "type": "array"
    },
    "simulation_source_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Simulation Source Hashes",
      "type": "object"
    },
    "split_seed": {
      "minimum": 0,
      "title": "Split Seed",
      "type": "integer"
    },
    "split_strategy": {
      "$ref": "#/$defs/SplitStrategy"
    },
    "status": {
      "$ref": "#/$defs/CalibrationStatus"
    },
    "target_deck_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Target Deck Versions",
      "type": "object"
    },
    "train_game_ids": {
      "items": {
        "type": "string"
      },
      "title": "Train Game Ids",
      "type": "array"
    },
    "validation_game_ids": {
      "items": {
        "type": "string"
      },
      "title": "Validation Game Ids",
      "type": "array"
    },
    "version_conflicts": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Version Conflicts",
      "type": "object"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "calibration_id",
    "created_at",
    "dataset_id",
    "dataset_version",
    "dataset_hash",
    "policy_version",
    "policy_hash",
    "simulation_source_hashes",
    "split_strategy",
    "split_seed",
    "train_game_ids",
    "validation_game_ids",
    "excluded_game_ids",
    "status",
    "comparisons",
    "parameter_results",
    "accepted_parameters",
    "confidence_level",
    "bootstrap_samples"
  ],
  "title": "CalibrationReport",
  "type": "object"
}
