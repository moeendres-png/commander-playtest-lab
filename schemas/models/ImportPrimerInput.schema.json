{
  "$defs": {
    "FormatBand": {
      "enum": [
        "local_meta",
        "normal_four_player",
        "high_power",
        "cedh_tournament",
        "large_pod",
        "historical_reference",
        "synthetic_assumption"
      ],
      "title": "FormatBand",
      "type": "string"
    },
    "PrimerFormat": {
      "enum": [
        "markdown",
        "text",
        "json",
        "curated"
      ],
      "title": "PrimerFormat",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "commander": {
      "title": "Commander",
      "type": "string"
    },
    "deck_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Deck Hash",
      "type": "string"
    },
    "format_band": {
      "$ref": "#/$defs/FormatBand"
    },
    "license_notes": {
      "default": "structured extraction only unless the source is user-provided",
      "title": "License Notes",
      "type": "string"
    },
    "primer_format": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrimerFormat"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "primer_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$",
      "title": "Primer Id",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "source_path",
    "primer_id",
    "source_id",
    "title",
    "commander",
    "deck_hash",
    "format_band"
  ],
  "title": "ImportPrimerInput",
  "type": "object"
}
