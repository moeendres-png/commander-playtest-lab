{
  "$defs": {
    "DataQuality": {
      "enum": [
        "authoritative",
        "project_verified",
        "project_inferred",
        "synthetic_assumption",
        "unknown"
      ],
      "title": "DataQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data As Of"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "quality": {
      "$ref": "#/$defs/DataQuality",
      "default": "unknown"
    },
    "retrieved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieved At"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "source_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Path"
    },
    "source_type": {
      "title": "Source Type",
      "type": "string"
    }
  },
  "required": [
    "source_type",
    "source_name"
  ],
  "title": "SourceRef",
  "type": "object"
}
