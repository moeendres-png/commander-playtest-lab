{
  "$defs": {
    "CardRole": {
      "enum": [
        "mana_source",
        "ramp",
        "draw",
        "selection",
        "removal",
        "counter",
        "protection",
        "wipe",
        "recursion",
        "graveyard_hate",
        "engine",
        "enabler",
        "payoff",
        "finisher",
        "combat_payoff",
        "token_source",
        "sacrifice_outlet",
        "land_synergy"
      ],
      "title": "CardRole",
      "type": "string"
    },
    "Color": {
      "enum": [
        "W",
        "U",
        "B",
        "R",
        "G"
      ],
      "title": "Color",
      "type": "string"
    },
    "OptimizationConstraints": {
      "additionalProperties": false,
      "properties": {
        "allowed_colors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Color"
          },
          "title": "Allowed Colors",
          "type": "array",
          "uniqueItems": true
        },
        "exact_card_count": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "title": "Exact Card Count",
          "type": "integer"
        },
        "high_mana_value_threshold": {
          "default": 5.0,
          "maximum": 20.0,
          "minimum": 0.0,
          "title": "High Mana Value Threshold",
          "type": "number"
        },
        "maximum_average_nonland_mana_value": {
          "default": 99.0,
          "maximum": 20.0,
          "minimum": 0.0,
          "title": "Maximum Average Nonland Mana Value",
          "type": "number"
        },
        "maximum_high_mana_value_cards": {
          "default": 100,
          "maximum": 100,
          "minimum": 0,
          "title": "Maximum High Mana Value Cards",
          "type": "integer"
        },
        "maximum_lands": {
          "default": 100,
          "maximum": 100,
          "minimum": 0,
          "title": "Maximum Lands",
          "type": "integer"
        },
        "minimum_colored_sources": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Color"
          },
          "title": "Minimum Colored Sources",
          "type": "object"
        },
        "minimum_lands": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Minimum Lands",
          "type": "integer"
        },
        "require_verified_inventory": {
          "default": true,
          "title": "Require Verified Inventory",
          "type": "boolean"
        },
        "role_minima": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/CardRole"
          },
          "title": "Role Minima",
          "type": "object"
        },
        "simultaneous_deck_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Simultaneous Deck Ids",
          "type": "array"
        },
        "singleton": {
          "default": true,
          "title": "Singleton",
          "type": "boolean"
        }
      },
      "title": "OptimizationConstraints",
      "type": "object"
    },
    "PilotDecisionMode": {
      "enum": [
        "deterministic",
        "stochastic"
      ],
      "title": "PilotDecisionMode",
      "type": "string"
    },
    "PilotStrength": {
      "enum": [
        "weak",
        "average",
        "strong",
        "near_optimal_heuristic"
      ],
      "title": "PilotStrength",
      "type": "string"
    },
    "VariantSwap": {
      "additionalProperties": false,
      "properties": {
        "add_candidate_id": {
          "title": "Add Candidate Id",
          "type": "string"
        },
        "remove": {
          "title": "Remove",
          "type": "string"
        }
      },
      "required": [
        "remove",
        "add_candidate_id"
      ],
      "title": "VariantSwap",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Token"
    },
    "constraints": {
      "anyOf": [
        {
          "$ref": "#/$defs/OptimizationConstraints"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deck_id": {
      "title": "Deck Id",
      "type": "string"
    },
    "holdout_pods": {
      "default": [
        [
          "synthetic/control",
          "synthetic/control",
          "synthetic/engine"
        ],
        [
          "synthetic/aggro",
          "synthetic/aggro",
          "synthetic/control"
        ]
      ],
      "items": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Holdout Pods",
      "type": "array"
    },
    "iterations": {
      "default": 100,
      "minimum": 1,
      "title": "Iterations",
      "type": "integer"
    },
    "max_turns": {
      "default": 35,
      "maximum": 500,
      "minimum": 1,
      "title": "Max Turns",
      "type": "integer"
    },
    "minimum_place_delta": {
      "default": 0.01,
      "maximum": 3.0,
      "minimum": -3.0,
      "title": "Minimum Place Delta",
      "type": "number"
    },
    "opponent_deck_ids": {
      "default": [
        "synthetic/aggro",
        "synthetic/control",
        "synthetic/engine"
      ],
      "items": {
        "type": "string"
      },
      "title": "Opponent Deck Ids",
      "type": "array"
    },
    "pilot_mode": {
      "$ref": "#/$defs/PilotDecisionMode",
      "default": "deterministic"
    },
    "pilot_strength": {
      "$ref": "#/$defs/PilotStrength",
      "default": "strong"
    },
    "seed": {
      "default": 20260804,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "sensitivity_seeds": {
      "default": [
        20260804,
        20260805,
        20260806
      ],
      "items": {
        "type": "integer"
      },
      "title": "Sensitivity Seeds",
      "type": "array"
    },
    "sensitivity_strengths": {
      "default": [
        "average",
        "strong",
        "near_optimal_heuristic"
      ],
      "items": {
        "$ref": "#/$defs/PilotStrength"
      },
      "title": "Sensitivity Strengths",
      "type": "array"
    },
    "swaps": {
      "items": {
        "$ref": "#/$defs/VariantSwap"
      },
      "title": "Swaps",
      "type": "array"
    },
    "workers": {
      "default": 1,
      "maximum": 64,
      "minimum": 1,
      "title": "Workers",
      "type": "integer"
    }
  },
  "required": [
    "deck_id",
    "swaps"
  ],
  "title": "OptimizationValidationInput",
  "type": "object"
}
