        "commander_games": {
          "default": false,
          "title": "Commander Games",
          "type": "boolean"
        },
        "commander_supported": {
          "default": false,
          "title": "Commander Supported",
          "type": "boolean"
        },
        "commander_tax_visible": {
          "default": false,
          "title": "Commander Tax Visible",
          "type": "boolean"
        },
        "deck_import_supported": {
          "default": false,
          "title": "Deck Import Supported",
          "type": "boolean"
        },
        "deck_loading": {
          "default": false,
          "title": "Deck Loading",
          "type": "boolean"
        },
        "deterministic_seed": {
          "default": false,
          "title": "Deterministic Seed",
          "type": "boolean"
        },
        "event_log_supported": {
          "default": false,
