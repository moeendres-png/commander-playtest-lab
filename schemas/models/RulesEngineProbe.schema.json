      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend Version"
    },
    "capabilities": {
      "$ref": "#/$defs/RulesEngineCapabilities"
    },
    "command": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "details": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Details",
      "type": "array"
    }
