{
  "$defs": {
    "CardLegality": {
      "enum": [
        "legal",
        "not_legal",
        "restricted",
        "banned",
        "unknown"
      ],
      "title": "CardLegality",
      "type": "string"
    },
    "Color": {
      "enum": [
        "W",
        "U",
        "B",
        "R",
        "G"
      ],
      "title": "Color",
      "type": "string"
    },
    "DataQuality": {
      "enum": [
        "authoritative",
        "project_verified",
        "project_inferred",
        "synthetic_assumption",
        "unknown"
      ],
      "title": "DataQuality",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "data_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data As Of"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "quality": {
          "$ref": "#/$defs/DataQuality",
          "default": "unknown"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_name"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "can_be_commander": {
      "default": false,
      "title": "Can Be Commander",
      "type": "boolean"
    },
    "color_identity": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Color"
      },
      "title": "Color Identity",
      "type": "array",
      "uniqueItems": true
    },
    "colors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Color"
      },
      "title": "Colors",
      "type": "array",
      "uniqueItems": true
    },
    "data_quality": {
      "$ref": "#/$defs/DataQuality",
      "default": "unknown"
    },
    "is_basic_land": {
      "default": false,
      "title": "Is Basic Land",
      "type": "boolean"
    },
    "keywords": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "array"
    },
    "legalities": {
      "additionalProperties": {
        "$ref": "#/$defs/CardLegality"
      },
      "title": "Legalities",
      "type": "object"
    },
    "mana_cost": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mana Cost"
    },
    "mana_value": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mana Value"
    },
    "max_deck_copies": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 1,
      "title": "Max Deck Copies"
    },
    "oracle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Oracle Id"
    },
    "oracle_name": {
      "minLength": 1,
      "title": "Oracle Name",
      "type": "string"
    },
    "oracle_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Oracle Text"
    },
    "partner_with": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Partner With",
      "type": "array"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Provenance",
      "type": "array"
    },
    "type_line": {
      "default": "Unknown",
      "title": "Type Line",
      "type": "string"
    }
  },
  "required": [
    "oracle_name"
  ],
  "title": "CardIdentity",
  "type": "object"
}
