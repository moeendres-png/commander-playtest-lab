{
  "$defs": {
    "SplitStrategy": {
      "enum": [
        "stable_hash",
        "chronological"
      ],
      "title": "SplitStrategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bootstrap_samples": {
      "default": 1000,
      "maximum": 100000,
      "minimum": 100,
      "title": "Bootstrap Samples",
      "type": "integer"
    },
    "confidence_level": {
      "default": 0.95,
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Confidence Level",
      "type": "number"
    },
    "dataset_version": {
      "default": "phase9-current",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Dataset Version",
      "type": "string"
    },
    "minimum_train_games": {
      "default": 20,
      "minimum": 2,
      "title": "Minimum Train Games",
      "type": "integer"
    },
    "minimum_train_observations": {
      "default": 12,
      "minimum": 2,
      "title": "Minimum Train Observations",
      "type": "integer"
    },
    "minimum_validation_games": {
      "default": 8,
      "minimum": 1,
      "title": "Minimum Validation Games",
      "type": "integer"
    },
    "minimum_validation_improvement": {
      "default": 0.05,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Minimum Validation Improvement",
      "type": "number"
    },
    "minimum_validation_observations": {
      "default": 5,
      "minimum": 1,
      "title": "Minimum Validation Observations",
      "type": "integer"
    },
    "output_name": {
      "default": "latest_calibration.json",
      "title": "Output Name",
      "type": "string"
    },
    "policy_path": {
      "default": "config/calibration_policy.json",
      "title": "Policy Path",
      "type": "string"
    },
    "simulation_result_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Simulation Result Paths",
      "type": "array"
    },
    "split_seed": {
      "default": 20260805,
      "minimum": 0,
      "title": "Split Seed",
      "type": "integer"
    },
    "split_strategy": {
      "$ref": "#/$defs/SplitStrategy",
      "default": "chronological"
    },
    "target_deck_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Target Deck Versions",
      "type": "object"
    },
    "train_fraction": {
      "default": 0.7,
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Train Fraction",
      "type": "number"
    }
  },
  "title": "CalibrateInput",
  "type": "object"
}
