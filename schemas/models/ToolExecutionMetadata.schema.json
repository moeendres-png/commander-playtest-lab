{
  "additionalProperties": false,
  "properties": {
    "configuration_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Hash"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_snapshot_hash": {
      "title": "Data Snapshot Hash",
      "type": "string"
    },
    "deck_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Deck Hashes",
      "type": "object"
    },
    "deterministic_game_log_directory": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deterministic Game Log Directory"
    },
    "elapsed_seconds": {
      "minimum": 0.0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "estimate_type": {
      "default": "structural_model_estimates",
      "enum": [
        "structural_model_estimates",
        "tactical_oracle_results",
        "external_rules_engine_results"
      ],
      "title": "Estimate Type",
      "type": "string"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "invocation_id": {
      "title": "Invocation Id",
      "type": "string"
    },
    "iterations": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Iterations"
    },
    "openai_trace_directory": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Openai Trace Directory"
    },
    "opponent_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Opponent Hashes",
      "type": "object"
    },
    "pilot_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pilot Version"
    },
    "scenario_hash": {
      "title": "Scenario Hash",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    }
  },
  "required": [
    "tool_name",
    "invocation_id",
    "created_at",
    "engine_version",
    "data_snapshot_hash",
    "scenario_hash",
    "elapsed_seconds"
  ],
  "title": "ToolExecutionMetadata",
  "type": "object"
}
