{
  "$defs": {
    "PlaytestParticipant": {
      "additionalProperties": false,
      "properties": {
        "commander_names": {
          "items": {
            "type": "string"
          },
          "title": "Commander Names",
          "type": "array"
        },
        "deck_name": {
          "title": "Deck Name",
          "type": "string"
        },
        "final_life": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Life"
        },
        "mulligans": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mulligans"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "placement": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placement"
        },
        "player_id": {
          "title": "Player Id",
          "type": "string"
        },
        "player_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Name"
        },
        "seat": {
          "minimum": 0,
          "title": "Seat",
          "type": "integer"
        }
      },
      "required": [
        "player_id",
        "deck_name",
        "seat"
      ],
      "title": "PlaytestParticipant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "end_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Reason"
    },
    "freeform_log": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freeform Log"
    },
    "game_id": {
      "title": "Game Id",
      "type": "string"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/PlaytestParticipant"
      },
      "title": "Participants",
      "type": "array"
    },
    "played_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Played On"
    },
    "pod_size": {
      "maximum": 10,
      "minimum": 2,
      "title": "Pod Size",
      "type": "integer"
    },
    "source_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source File"
    },
    "starting_player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Starting Player Id"
    },
    "turns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turns"
    },
    "validated": {
      "default": false,
      "title": "Validated",
      "type": "boolean"
    },
    "winner_player_ids": {
      "items": {
        "type": "string"
      },
      "title": "Winner Player Ids",
      "type": "array"
    }
  },
  "required": [
    "game_id",
    "pod_size",
    "participants"
  ],
  "title": "RealPlaytest",
  "type": "object"
}
