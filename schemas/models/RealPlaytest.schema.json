{
  "$defs": {
    "EvidenceSplit": {
      "enum": [
        "unsplit",
        "train",
        "validation",
        "excluded"
      ],
      "title": "EvidenceSplit",
      "type": "string"
    },
    "PlaytestParticipant": {
      "additionalProperties": false,
      "properties": {
        "archenemy_events": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archenemy Events"
        },
        "boardwipes_cast": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boardwipes Cast"
        },
        "boardwipes_seen": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boardwipes Seen"
        },
        "commander_casts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commander Casts"
        },
        "commander_names": {
          "items": {
            "type": "string"
          },
          "title": "Commander Names",
          "type": "array"
        },
        "commander_removals_received": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commander Removals Received"
        },
        "dead_cards": {
          "items": {
            "type": "string"
          },
          "title": "Dead Cards",
          "type": "array"
        },
        "deck_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deck Hash"
        },
        "deck_name": {
          "minLength": 1,
          "title": "Deck Name",
          "type": "string"
        },
        "deck_version": {
          "default": "unversioned",
          "minLength": 1,
          "title": "Deck Version",
          "type": "string"
        },
        "final_life": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Life"
        },
        "first_commander_cast_turn": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Commander Cast Turn"
        },
        "first_independent_draw_engine_turn": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Independent Draw Engine Turn"
        },
        "first_ramp_turn": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Ramp Turn"
        },
        "independent_draw_engines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Independent Draw Engines"
        },
        "ishai_peak_power": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ishai Peak Power"
        },
        "ishai_power_by_turn": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Ishai Power By Turn",
          "type": "object"
        },
        "korvold_cards_drawn": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Korvold Cards Drawn"
        },
        "lands_played": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lands Played"
        },
        "loss_causes": {
          "items": {
            "type": "string"
          },
          "title": "Loss Causes",
          "type": "array"
        },
        "mulligans": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mulligans"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "placement": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placement"
        },
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "player_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Name"
        },
        "ramp_events": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ramp Events"
        },
        "rebuilt_after_wipe": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rebuilt After Wipe"
        },
        "removal_events": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Removal Events"
        },
        "seat": {
          "minimum": 0,
          "title": "Seat",
          "type": "integer"
        },
        "sequencing_errors": {
          "items": {
            "type": "string"
          },
          "title": "Sequencing Errors",
          "type": "array"
        },
        "starting_hand_lands": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starting Hand Lands"
        },
        "successful_rebuilds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Successful Rebuilds"
        },
        "was_archenemy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Was Archenemy"
        },
        "win_axis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Win Axis"
        }
      },
      "required": [
        "player_id",
        "deck_name",
        "seat"
      ],
      "title": "PlaytestParticipant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_version": {
      "default": "unversioned",
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "end_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Reason"
    },
    "evidence_split": {
      "$ref": "#/$defs/EvidenceSplit",
      "default": "unsplit"
    },
    "excluded_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excluded Reason"
    },
    "freeform_log": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freeform Log"
    },
    "game_id": {
      "minLength": 1,
      "title": "Game Id",
      "type": "string"
    },
    "imported_at": {
      "format": "date-time",
      "title": "Imported At",
      "type": "string"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/PlaytestParticipant"
      },
      "title": "Participants",
      "type": "array"
    },
    "played_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Played On"
    },
    "pod_size": {
      "maximum": 10,
      "minimum": 2,
      "title": "Pod Size",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source File"
    },
    "source_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    },
    "starting_player_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Starting Player Id"
    },
    "turns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turns"
    },
    "validated": {
      "default": false,
      "title": "Validated",
      "type": "boolean"
    },
    "validation_errors": {
      "items": {
        "type": "string"
      },
      "title": "Validation Errors",
      "type": "array"
    },
    "winner_player_ids": {
      "items": {
        "type": "string"
      },
      "title": "Winner Player Ids",
      "type": "array"
    }
  },
  "required": [
    "game_id",
    "pod_size",
    "participants"
  ],
  "title": "RealPlaytest",
  "type": "object"
}
