{
  "$defs": {
    "MetaCategory": {
      "enum": [
        "local_meta",
        "normal_four_player",
        "high_power",
        "cedh_tournament",
        "large_pod",
        "historical_reference",
        "synthetic_assumption"
      ],
      "title": "MetaCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "categories": {
      "items": {
        "$ref": "#/$defs/MetaCategory"
      },
      "title": "Categories",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deck_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Deck Hashes",
      "type": "array"
    },
    "immutable": {
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "supersedes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Supersedes",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "created_at",
    "source_ids",
    "deck_hashes",
    "categories"
  ],
  "title": "MetaSnapshotManifest",
  "type": "object"
}
