{
  "$defs": {
    "EvidenceSplit": {
      "enum": [
        "unsplit",
        "train",
        "validation",
        "excluded"
      ],
      "title": "EvidenceSplit",
      "type": "string"
    },
    "SplitStrategy": {
      "enum": [
        "stable_hash",
        "chronological"
      ],
      "title": "SplitStrategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Data Hash",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "excluded_games": {
      "minimum": 0,
      "title": "Excluded Games",
      "type": "integer"
    },
    "game_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Game Hashes",
      "type": "object"
    },
    "game_ids": {
      "items": {
        "type": "string"
      },
      "title": "Game Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_files": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Files",
      "type": "array"
    },
    "split_assignments": {
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceSplit"
      },
      "title": "Split Assignments",
      "type": "object"
    },
    "split_sealed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split Sealed At"
    },
    "split_seed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split Seed"
    },
    "split_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/SplitStrategy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "train_fraction": {
      "anyOf": [
        {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Train Fraction"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "validated_games": {
      "minimum": 0,
      "title": "Validated Games",
      "type": "integer"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "created_at",
    "updated_at",
    "game_ids",
    "game_hashes",
    "data_hash",
    "validated_games",
    "excluded_games"
  ],
  "title": "PlaytestDatasetManifest",
  "type": "object"
}
