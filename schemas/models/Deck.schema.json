{
  "$defs": {
    "Color": {
      "enum": [
        "W",
        "U",
        "B",
        "R",
        "G"
      ],
      "title": "Color",
      "type": "string"
    },
    "CommanderConfiguration": {
      "additionalProperties": false,
      "properties": {
        "commander_identity_override": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Color"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commander Identity Override"
        },
        "commanders": {
          "items": {
            "type": "string"
          },
          "title": "Commanders",
          "type": "array"
        },
        "uses_partner": {
          "default": false,
          "title": "Uses Partner",
          "type": "boolean"
        }
      },
      "required": [
        "commanders"
      ],
      "title": "CommanderConfiguration",
      "type": "object"
    },
    "DataQuality": {
      "enum": [
        "authoritative",
        "project_verified",
        "project_inferred",
        "synthetic_assumption",
        "unknown"
      ],
      "title": "DataQuality",
      "type": "string"
    },
    "DeckEntry": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "oracle_name": {
          "minLength": 1,
          "title": "Oracle Name",
          "type": "string"
        },
        "physical_copy_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Physical Copy Ids",
          "type": "array"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "zone": {
          "$ref": "#/$defs/DeckZone",
          "default": "main"
        }
      },
      "required": [
        "oracle_name"
      ],
      "title": "DeckEntry",
      "type": "object"
    },
    "DeckZone": {
      "enum": [
        "commander",
        "main",
        "sideboard",
        "maybeboard"
      ],
      "title": "DeckZone",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "data_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data As Of"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "quality": {
          "$ref": "#/$defs/DataQuality",
          "default": "unknown"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_name"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cards": {
      "items": {
        "$ref": "#/$defs/DeckEntry"
      },
      "title": "Cards",
      "type": "array"
    },
    "commander": {
      "$ref": "#/$defs/CommanderConfiguration"
    },
    "data_as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data As Of"
    },
    "deck_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deck Hash"
    },
    "deck_id": {
      "minLength": 1,
      "title": "Deck Id",
      "type": "string"
    },
    "format": {
      "default": "commander",
      "title": "Format",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "deck_id",
    "name",
    "commander",
    "cards"
  ],
  "title": "Deck",
  "type": "object"
}
