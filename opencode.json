{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/space-bunny-free",
  "small_model": "opencode-go/space-bunny-free",
  "default_agent": "foundry-implementer",
  "share": "disabled",
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "enabled_providers": ["opencode-go"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow"
    },
    "list": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow"
    },
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "doom_loop": "deny",
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "env": "deny",
      "env *": "deny",
      "printenv*": "deny",
      "set": "deny",
      "set *": "deny",
      "export": "deny",
      "declare -x": "deny",
      "gh auth*": "deny",
      "gh secret*": "deny",
      "cat *id_rsa*": "deny",
      "cat *.pem": "deny",
      "cat *.key": "deny",
      "cat *credentials*": "deny",
      "cat *.netrc": "deny",
      "sudo*": "deny",
      "su *": "deny",
      "doas*": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -fr /": "deny",
      "rm -fr /*": "deny",
      "gh repo delete*": "deny",
      "gh repo create*": "deny",
      "gh repo fork*": "deny",
      "gh ssh-key*": "deny",
      "gh gpg-key*": "deny"
    },
    "task": {
      "*": "ask",
      "explore": "allow",
      "foundry-adjudicator": "allow",
      "foundry-reviewer": "allow",
      "general": "allow"
    },
    "external_directory": {
      "*": "allow",
      "/home/moeen/code/*": "allow",
      "/tmp/*": "allow"
    }
  },
  "provider": {
    "opencode-go": {
      "whitelist": ["space-bunny-free", "muse-spark-1.3-contributor"],
      "models": {
        "space-bunny-free": {
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "none": {
              "disabled": true
            },
            "off": {
              "disabled": true
            },
            "minimal": {
              "disabled": true
            },
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "disabled": true
            },
            "xhigh": {
              "disabled": true
            },
            "max": {}
          }
        },
        "muse-spark-1.3-contributor": {
          "options": {
            "reasoningEffort": "xhigh"
          },
          "variants": {
            "none": {
              "disabled": true
            },
            "off": {
              "disabled": true
            },
            "minimal": {
              "disabled": true
            },
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "disabled": true
            },
            "xhigh": {}
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "variant": "max"
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "effect": "deny",
        "resource": "*"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "opencode-go"
      }
    ]
  }
}
