  "provider": {
    "opencode-go": {
      "whitelist": [
        "muse-spark-1.3-contributor"
      ],
      "models": {
        "muse-spark-1.3-contributor": {
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "none": {
              "disabled": true
            },
            "off": {
              "disabled": true
            },
            "minimal": {
              "disabled": true
            },
            "low": {
              "disabled": true
            },
            "medium": {
              "disabled": true
            },
            "high": {},
            "xhigh": {}
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "variant": "high"
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "effect": "deny",
        "resource": "*"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "opencode-go"
      }
    ]
  }
