setuptools>=75
wheel
# --- platform-conditional closure (3.12 linux/win32 completeness) ---
# pip-compile resolves for the compiling interpreter, so requirements that
# only apply on other platforms/python versions need explicit conditional
# inputs; otherwise a locked `--require-hashes` install there would hit the
# network for an unpinned artifact and fail. Membership verified by
# scripts/verify_dependency_lock.py against pinned-version metadata.
colorama>=0.4; sys_platform == 'win32'
pywin32>=310; sys_platform == 'win32' and python_version < '3.14'

