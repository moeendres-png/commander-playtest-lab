diff --git a/Mage.Sets/src/mage/cards/m/Missy.java b/Mage.Sets/src/mage/cards/m/Missy.java
new file mode 100644
index 00000000..db09e17a
--- /dev/null
+++ b/Mage.Sets/src/mage/cards/m/Missy.java
@@ -0,0 +1,52 @@
+package mage.cards.m;
+
+import java.util.UUID;
+import mage.MageInt;
+import mage.abilities.Ability;
+import mage.abilities.common.DiesCreatureTriggeredAbility;
+import mage.abilities.effects.common.GainLifeEffect;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.constants.CardType;
+import mage.constants.SubType;
+import mage.constants.SuperType;
+import mage.filter.FilterPermanent;
+import mage.filter.common.FilterCreaturePermanent;
+import mage.filter.predicate.mageobject.AnotherPredicate;
+
+/**
+ * Simplified implementation for Commander Lab simulation.
+ * Face-down return ability omitted (too complex).
+ *
+ * @author Muse
+ */
+public final class Missy extends CardImpl {
+
+    private static final FilterPermanent filter = new FilterCreaturePermanent("another creature");
+
+    static {
+        filter.add(AnotherPredicate.instance);
+    }
+
+    public Missy(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.CREATURE}, "{3}{U}{B}{R}");
+        this.addSuperType(SuperType.LEGENDARY);
+        this.subtype.add(SubType.TIME_LORD);
+        this.subtype.add(SubType.VILLAIN);
+
+        this.power = new MageInt(4);
+        this.toughness = new MageInt(5);
+
+        // Whenever another creature dies, you gain 1 life.
+        this.addAbility(new DiesCreatureTriggeredAbility(new GainLifeEffect(1), false, filter));
+    }
+
+    private Missy(final Missy card) {
+        super(card);
+    }
+
+    @Override
+    public Missy copy() {
+        return new Missy(this);
+    }
+}
