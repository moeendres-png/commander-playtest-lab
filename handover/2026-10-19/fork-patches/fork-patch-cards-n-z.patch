+package mage.cards.t;
+
+import java.util.UUID;
+import mage.abilities.Ability;
+import mage.abilities.common.SimpleActivatedAbility;
+import mage.abilities.costs.common.TapSourceCost;
+import mage.abilities.costs.mana.ManaCostsImpl;
+import mage.abilities.effects.common.PhaseOutTargetEffect;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.constants.CardType;
+import mage.constants.Zone;
+import mage.filter.FilterPermanent;
+import mage.filter.predicate.Predicates;
+import mage.target.TargetPermanent;
+
+/**
+ * @author Muse (Commander Playtest Lab)
+ *
+ * The Pandorica {2}{W}
+ * Artifact
+ * You may choose not to untap The Pandorica during your untap step.
+ * {1}{W}, {T}: Untap another target nonland permanent, then it phases out.
+ * Activate only as a sorcery.
+ *
+ * Note: Simplified implementation - the "can't phase in while tapped" and
+ * "phases in when untapped/leaves" parts are omitted for simulation purposes.
+ * The core "phase out target" functionality is preserved.
+ */
+public final class ThePandorica extends CardImpl {
+
+    private static final FilterPermanent filter = new FilterPermanent("another target nonland permanent");
+
+    static {
+        filter.add(Predicates.not(CardType.LAND.getPredicate()));
+    }
+
+    public ThePandorica(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.ARTIFACT}, "{2}{W}");
+
+        // {1}{W}, {T}: Untap another target nonland permanent, then it phases out. Activate only as a sorcery.
+        Ability ability = new SimpleActivatedAbility(
+            new PhaseOutTargetEffect(),
+            new ManaCostsImpl<>("{1}{W}")
+        );
+        ability.addCost(new TapSourceCost());
+        ability.addTarget(new TargetPermanent(filter));
+        // TODO: Add "untap target" and "activate only as sorcery" restriction
+        // TODO: Add "you may choose not to untap" static ability
+        // TODO: Add "can't phase in while tapped" continuous effect
+        this.addAbility(ability);
+    }
+
+    private ThePandorica(final ThePandorica card) {
+        super(card);
+    }
+
+    @Override
+    public ThePandorica copy() {
+        return new ThePandorica(this);
+    }
+}
