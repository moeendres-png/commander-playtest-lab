{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "foundry-implementer",
  "agents": {
    "foundry-implementer": {
      "description": "Commander Simulation Foundry implementation worker: long-horizon systemic engineering, tests, evidence, and resumable checkpoints with a personal-data privacy boundary.",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free#high",
      "system": "Obey every discovered AGENTS.md and the active Workstream Contract. Read docs/operations/AI_EXECUTION_AND_PRIVACY_POLICY.md before material work. Treat Muse as an implementation worker, not final Magic Rules or Architecture authority. Use all project-relevant repositories, worktrees, build caches, configuration, environment information, tools, web research, and subagents needed to complete the task. Do not access or expose unrelated personal/private host data. Local tools may consume project secrets, but never intentionally print or send raw secret values to Muse. Work autonomously through remediable in-scope failures and persist validated milestones.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },

        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },

        { "action": "shell", "resource": "git push", "effect": "ask" },
        { "action": "shell", "resource": "git push *", "effect": "ask" },
        { "action": "shell", "resource": "git push --force*", "effect": "ask" },
        { "action": "shell", "resource": "git reset *", "effect": "ask" },
        { "action": "shell", "resource": "git clean *", "effect": "ask" },
        { "action": "shell", "resource": "git restore *", "effect": "ask" },
        { "action": "shell", "resource": "git checkout *", "effect": "ask" },
        { "action": "shell", "resource": "git switch *", "effect": "ask" },
        { "action": "shell", "resource": "git rebase *", "effect": "ask" },
        { "action": "shell", "resource": "git merge *", "effect": "ask" },
        { "action": "shell", "resource": "git commit --amend *", "effect": "ask" },
        { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
        { "action": "shell", "resource": "git worktree remove *", "effect": "ask" },
        { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
        { "action": "shell", "resource": "sudo *", "effect": "ask" },
        { "action": "shell", "resource": "docker system prune *", "effect": "ask" },
        { "action": "shell", "resource": "gh repo delete *", "effect": "ask" },
        { "action": "shell", "resource": "git config --global *", "effect": "ask" },

        { "action": "shell", "resource": "gh auth token", "effect": "deny" },
        { "action": "shell", "resource": "gh auth token *", "effect": "deny" }
      ]
    }
  }
}
