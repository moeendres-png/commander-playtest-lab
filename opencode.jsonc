{
  "$schema": "https://opencode.ai/config.json",

  // Muse Spark 1.3 Contributor Free is the intended zero-cost OpenCode lane.
  // Verify in the OpenCode UI that OpenCode Zen is connected and this exact
  // Free model is selected before beginning a material task. If the Free SKU
  // disappears, do not assume an automatic paid fallback is acceptable.
  "model": "opencode/muse-spark-1.3-contributor-free",
  "default_agent": "foundry-implementer",

  // OpenCode V1-compatible compaction. Keep automatic compaction enabled and
  // reserve enough context for a clean checkpoint/handoff. Durable Git/state
  // remains authoritative because compaction is lossy.
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 32000
  },

  // Keep file watching focused on source/evidence rather than build/cache noise.
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "engine-bridge/target/**",
      "dist/**"
    ]
  },

  // V1 permission syntax. OpenCode V2 can normalize supported V1 config, so
  // this shape is intentionally the cross-version baseline while Desktop uses
  // the stable V1 server/client path.
  "permission": {
    "*": "ask",

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow"
    },

    "glob": "allow",
    "grep": "allow",
    "websearch": "allow",
    "webfetch": "allow",

    "task": {
      "*": "ask",
      "explore": "allow",
      "foundry-reviewer": "allow"
    },

    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny"
    },

    "bash": {
      "*": "allow",
      "git push": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git branch -D *": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "rm -rf *": "ask",
      "del *": "ask",
      "rmdir *": "ask",
      "Remove-Item *": "ask"
    },

    "external_directory": "ask"
  }
}
