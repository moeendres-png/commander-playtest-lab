{
  "$schema": "https://opencode.ai/config.json",

  // Muse Spark 1.3 Contributor Free is the intended zero-cost OpenCode lane.
  // Verify in the OpenCode UI that OpenCode Zen is connected and this exact
  // Free model is selected before beginning a material task. If the Free SKU
  // disappears, do not assume an automatic paid fallback is acceptable.
  "model": "opencode/muse-spark-1.3-contributor-free",
  "default_agent": "foundry-implementer",

  // Preserve more recent detail than the V2 default while still compacting
  // automatically. Durable workstream state/commits remain authoritative
  // because compaction is lossy.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 30000
    },
    "buffer": 32000
  },

  // Keep file watching focused on source/evidence rather than build/cache noise.
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "engine-bridge/target/**",
      "dist/**"
    ]
  },

  // OpenCode is intentionally fairly autonomous inside the repository because
  // Muse Free capacity is useful for long implementation/test/repair loops.
  // Remote publication and destructive operations remain approval-gated.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/*.env", "effect": "deny" },
    { "action": "read", "resource": "**/*.env.*", "effect": "deny" },

    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },

    { "action": "subagent", "resource": "*", "effect": "ask" },
    { "action": "subagent", "resource": "explore", "effect": "allow" },
    { "action": "subagent", "resource": "foundry-reviewer", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "**/*.env", "effect": "deny" },
    { "action": "edit", "resource": "**/*.env.*", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git merge *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },

    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "del *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "ask" },

    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ]
}
